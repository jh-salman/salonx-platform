{
  "name": "@repo/sdk",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../../openapi.yaml -o src/generated.ts",
    "build": "tsc",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.22.4",
    "ky": "^1.1.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "openapi-typescript": "^6.7.1",
    "@types/node": "^20.10.4",
    "typescript": "5.9.2",
    "eslint": "^9.34.0"
  }
}
